---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
---

<Layout title={`Page not found · ${SITE.name}`} noindex>
  <h1>Page not found</h1>
  <p>
    There’s nothing at this address. If you followed a link to an older version of this site, the
    page may have moved when I rebuilt it.
  </p>
  <p>
    You can <a href="/#work">see my work</a> or <a href="/about/">read about me</a>.
  </p>
</Layout>
