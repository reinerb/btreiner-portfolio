---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
import { mailtoLink } from '../lib/email';

const resume = await getEntry('resume', 'resume');
if (!resume) throw new Error('Missing src/content/resume/resume.yaml');
const { contact, summary, summaryClosing, experience, projects, skills, education } = resume.data;
---

<Layout
  title={`Resume · ${SITE.name}`}
  description="Benjamin Reiner’s resume: web development since 2019, mostly for nonprofits and small organizations, with a PDF version to download."
>
  <article class="resume">
    <header>
      <h1>{contact.name}</h1>
      <p>{contact.title} · {contact.region}</p>
      <ul class="contact">
        <li><Fragment set:html={mailtoLink(contact.email)} /></li>
        <li><a href={`https://${contact.website}`}>{contact.website}</a></li>
        <li><a href={`https://${contact.github}`}>{contact.github}</a></li>
        <li><a href={`https://${contact.linkedin}`}>{contact.linkedin}</a></li>
      </ul>
    </header>

    <p class="pdf-link"><a href="/benjamin-reiner-resume.pdf">Download the PDF</a></p>

    <section>
      <h2>Summary</h2>
      <p>{summary}{summaryClosing && ` ${summaryClosing}`}</p>
    </section>

    <section>
      <h2>Experience</h2>
      {experience.map((job) => (
        <article>
          <h3>{job.title}</h3>
          <p class="facts">{job.organization}, {job.location} · {job.dates}</p>
          <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        </article>
      ))}
    </section>

    <section>
      <h2>Projects</h2>
      {projects.map((project) => (
        <article>
          <h3>{project.name}</h3>
          <p class="facts">
            {project.kind} · {project.year}
            {project.link && <> · <a href={`https://${project.link}`}>{project.link}</a></>}
          </p>
          <ul>{project.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        </article>
      ))}
    </section>

    <section>
      <h2>Skills</h2>
      <dl>
        {skills.map((skill) => (
          <div><dt>{skill.label}</dt><dd>{skill.items}</dd></div>
        ))}
      </dl>
    </section>

    <section>
      <h2>Education</h2>
      {education.map((school) => (
        <article>
          <h3>{school.degree}</h3>
          <p class="facts">{school.school}, {school.location} · {school.dates}</p>
          {school.bullets && <ul>{school.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        </article>
      ))}
    </section>
  </article>
</Layout>
