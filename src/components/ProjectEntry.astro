---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, client, year, stack, caseStudy, linkLabel, tier } = entry.data;
const { Content } = await render(entry);

const facts = [client, year, stack.join(', ')].join(' · ');
---

<article class={`entry entry-${tier}`}>
  <h3 style={caseStudy ? `view-transition-name: ${caseStudy.id}` : undefined}>{title}</h3>
  <p class="facts">{facts}</p>
  <Content />
  {caseStudy && (
    <p class="entry-link">
      <a href={`/work/${caseStudy.id}/`}>{linkLabel}</a>
    </p>
  )}
</article>
