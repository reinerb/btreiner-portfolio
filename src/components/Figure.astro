---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Display width in CSS pixels, for screenshots narrower than the text column. */
  width?: number;
}

const { src, alt, caption, width } = Astro.props;

// 36rem at a 16px root. Update if the text column changes.
const COLUMN_WIDTH = 576;

const displayWidth = width ?? Math.min(src.width, COLUMN_WIDTH);
const displayHeight = Math.round((displayWidth * src.height) / src.width);
---

<figure class="figure" style={width ? `max-width: ${width}px` : undefined}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    layout={width ? 'fixed' : 'constrained'}
    width={displayWidth}
    height={displayHeight}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.5rem 0;
  }
  .figure :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.82em;
    color: var(--muted);
  }
  @media (prefers-color-scheme: dark) {
    .figure :global(img) {
      filter: brightness(0.9);
    }
  }
</style>
