---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Display width in CSS pixels, for images narrower than the text column. */
  width?: number;
  /** Spans the left rail on wide screens. For large screenshots. */
  wide?: boolean;
  /** A photo, not a screenshot: no border. */
  photo?: boolean;
  /** Above the fold: load right away, at high priority. */
  priority?: boolean;
}

const { src, alt, caption, width, wide = false, photo = false, priority = false } = Astro.props;

// 36rem and 50rem at a 16px root. Keep in step with --column and --page in global.css.
const COLUMN_WIDTH = 576;
const PAGE_WIDTH = 800;

const maxWidth = wide ? PAGE_WIDTH : COLUMN_WIDTH;
const displayWidth = width ?? Math.min(src.width, maxWidth);
const displayHeight = Math.round((displayWidth * src.height) / src.width);
---

<figure
  class:list={['figure', { wide, photo }]}
  style={width ? `max-width: ${width}px` : undefined}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    layout={width ? 'fixed' : 'constrained'}
    width={displayWidth}
    height={displayHeight}
    priority={priority}
    loading={priority ? undefined : "lazy"}
    decoding={priority ? undefined : "async"}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.6em 0;
  }
  .figure :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .photo :global(img) {
    border: 0;
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.82em;
  }
  @media (prefers-color-scheme: dark) {
    .figure :global(img) {
      filter: brightness(0.9);
    }
  }
  @media (min-width: 58rem) {
    .wide {
      margin-left: var(--into-rail);
    }
  }
</style>
